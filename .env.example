# ═══════════════════════════════════════════════════════════════════════════
# NexGen — environment template
#
# Copy to `.env` (same directory as manage.py) and fill in real values:
#     cp .env.example .env
#
# `.env` is gitignored; this template must never contain real secrets.
# Loaded by core/settings.py via `load_dotenv(BASE_DIR / ".env")`.
#
# Only variables actually read by core/settings.py are listed. Anything not
# set here falls back to the default shown in the comment.
# ═══════════════════════════════════════════════════════════════════════════

# ─── Core Django ───────────────────────────────────────────────────────────
# Generate with:
#   python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=replace-me

# "True" enables debug. Anything else (including "true") means False.
DJANGO_DEBUG=False

# Comma-separated. Drives both ALLOWED_HOSTS and CSRF_TRUSTED_ORIGINS
# (https://<host> and https://<host>:8443 are trusted automatically).
# For phone-on-LAN testing add your machine's IP, e.g. 192.168.1.50
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Public base URL used to build links inside outgoing email.
SITE_URL=https://nexgen.e-meril.in


# ─── PostgreSQL (default database) ─────────────────────────────────────────
# Defaults if unset: django_db / django_user / django_password
#                    host.containers.internal : 5432
POSTGRES_DB=nexgen
POSTGRES_USER=nexgen_user
POSTGRES_PASSWORD=replace-me

# Container/service name when Django runs inside the compose network (e.g. "db").
# Running Django on the host against a containerised Postgres instead?
# Use 127.0.0.1 and make sure the container publishes 5432.
DB_HOST=127.0.0.1
DB_PORT=5432


# ─── Zoho OAuth2 SSO ───────────────────────────────────────────────────────
# From https://api-console.zoho.in → your "Server-based Application".
# Backend: main.backends.ZohoOAuth2 (accounts.zoho.in — the .in datacentre).
ZOHO_CLIENT_ID=1000.XXXXXXXXXXXXXXXXXXXXXXXXXXXXXX
ZOHO_CLIENT_SECRET=replace-me

# MUST match a Redirect URI registered in the Zoho console *character for
# character*, including scheme, port and trailing slash. social_django is
# mounted at /oauth/ (see main/urls.py), so the path is /oauth/complete/zoho/.
#
#   production : https://gpt.e-meril.in/oauth/complete/zoho/
#   LAN dev    : http://192.168.1.50:8000/oauth/complete/zoho/
#
# Pin this to the SAME URL for both web and mobile logins - a mobile client
# should open its login flow against this same public domain rather than a
# raw dev IP:port, so there is only ever one redirect_uri to register with
# Zoho. Leave blank to let social-auth derive it from the request host — not
# recommended, since hitting the server by IP then breaks the callback.
ZOHO_REDIRECT_URI=https://gpt.e-meril.in/oauth/complete/zoho/


# ─── Email / SMTP ──────────────────────────────────────────────────────────
# Warehouse Inspection sends per-checkpoint and summary mail on submit.
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.zoho.in
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_USE_SSL=False

# Zoho SMTP expects the FULL mailbox address as the username.
EMAIL_HOST_USER=noreply@merillife.com
# Use a Zoho *application-specific password*, not the account password.
EMAIL_HOST_PASSWORD=replace-me

EMAIL_TIMEOUT=20
DEFAULT_FROM_EMAIL=noreply@merillife.com

# To verify SMTP without sending real mail, swap the backend for:
#   EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend


# ─── Warehouse Inspection notifications ────────────────────────────────────
# Report recipients (daily activity report + consolidated summary email) are
# no longer configured here - manage them from the app at
# /warehouse-inspection/admin/report-recipients/ (Report Recipients master).

# Send mail to the responsible person configured per floor/checkpoint.
# Set False to suppress all per-responsible mail while testing.
WAREHOUSE_INSPECTION_SEND_RESPONSIBLE_EMAILS=True

# When DEBUG=True, per-checkpoint internal-department CC emails go here
# instead of the real internal_department_email on the response.
WAREHOUSE_INSPECTION_DEBUG_INTERNAL_EMAILS=

# Floor→owner overrides for testing. Format: "Floor Name=email;Floor Name=email"
WAREHOUSE_INSPECTION_DEBUG_FLOOR_EMAILS=

# Always CC'd on every warehouse inspection email (submission, summary,
# reminder, daily report) IN ADDITION to whatever the real/debug recipients
# already are - independent of DEBUG, so you can watch everything while
# testing without it silently stopping once DEBUG is turned off.
WAREHOUSE_INSPECTION_TESTING_CC=

# Overrides DEFAULT_FROM_EMAIL for inspection mail only.
WAREHOUSE_INSPECTION_FROM=

# Shared secret for POST /warehouse-inspection/api/run-daily-emails/, the
# endpoint n8n calls at 09:00 to send reminders + the DGM report. Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
# Leave blank to disable the endpoint (it will always return 403).
WAREHOUSE_INSPECTION_RUN_SECRET=

WAREHOUSE_INSPECTION_EMAIL_TIMEOUT=20

# ─── VendorLink ───────────────────────────────────────
# Rates for converting vendor bids to INR. Blank disables conversion: bids are
# then shown only in the currency each vendor quoted, and no cross-currency
# comparison is offered — which is the safe default, since ranking vendors on
# unconverted figures ranks them by currency rather than by price.
CURRENCY_CONVERSION_API_KEY=
# Which service the key belongs to. Left explicit because the key alone does
# not identify a provider.
CURRENCY_CONVERSION_PROVIDER=exchangerate-api

# ─── VendorLink ──────────────────────────────────────────────────────────────
# Hours a newly onboarded vendor may reach back for RFIs raised before they
# existed on the platform. Requests they were explicitly emailed are always
# reachable; 0 disables the reach-back. Default 24 (same working day).
VENDORLINK_LATE_BID_GRACE_HOURS=24

# ─── Container image tag ─────────────────────────────────────────────────────
# Used by BOTH docker-compose.yml (build) and docker-compose.registry.yml
# (pull). Their own defaults differ — v5.1.0 and v5.2.0 — so a local build and
# a production pull were never guaranteed to be the same image. Setting it here
# makes them agree. Bump it to cut a new version.
APP_TAG=v5.3.0
