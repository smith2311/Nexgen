# only; Django app tests.py files, pytest modules and tests/ packages should
# not be committed.
tests/
tests.py
test_*.py
*_test.py
*_tests.py
conftest.py
pytest.ini
settings_test.py
test_db.sqlite3
*test_report*.xlsx
